# MongoDB connection string (local or Atlas)
MONGODB_URL=mongodb://127.0.0.1:27017/interviewiq

# Any long random string - used to sign auth JWTs
JWT_SECRET=change-me-to-a-long-random-string

# Groq API key - required for resume analysis, question generation and scoring.
# Get one free at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the Groq model without touching code.
# If you get "The model ... does not exist or you do not have access to it",
# run `curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"`
# to list what your key can actually reach, then set one here. Known-good
# production options: openai/gpt-oss-120b, openai/gpt-oss-20b
# GROQ_MODEL=openai/gpt-oss-120b

# Sarvam AI key - required for text-to-speech during the interview
SARVAM_API_KEY=

# Razorpay - required only for the credits/pricing flow
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Where the frontend runs (used for CORS)
CLIENT_URL=http://localhost:5173

PORT=8000
